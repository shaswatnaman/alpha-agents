# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── API Keys (comma-separated) ────────────────────────────────────────────────
VALID_API_KEYS=your-key-1,your-key-2

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://alphaagents:alphaagents@localhost:5432/alphaagents

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Observability ──────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
